    <spring.security.version>6.1.5</spring.security.version>
    <spring-session.version>3.4.2</spring-session.version>
    <jersey.version>3.1.5</jersey.version> <!-- Zaktualizowano do Jersey 3.x -->
    <swagger.version>2.2.0</swagger.version>
    <spring.ldap.version>3.1.3</spring.ldap.version>
    <spring-data-solr.version>4.3.15</spring-data-solr.version>
    <spring-data.version>2.5.10</spring-data.version>
